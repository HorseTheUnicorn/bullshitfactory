[Unit]
Description=Bullshit Factory server-local Kokoro speech service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bullshit-factory
Group=bullshit-factory
WorkingDirectory=/opt/bullshit-factory
EnvironmentFile=-/etc/bullshit-factory/bullshit-factory.env
Environment=BF_TTS_HOST=127.0.0.1
Environment=BF_TTS_PORT=8798
Environment=BF_TTS_MODEL_PATH=/opt/bullshit-factory/models/kokoro/kokoro-v1.0.onnx
Environment=BF_TTS_VOICES_PATH=/opt/bullshit-factory/models/kokoro/voices-v1.0.bin
Environment=BF_TTS_ORANGE_IDIOT_MIX_SOURCES=am_echo,am_michael
Environment=BF_TTS_CUSTOM_VOICES_PATH=/home/goblin/cave/kokovoicelab/exported_voices/bullshit-factory-custom.bin
Environment=BF_TTS_VOICE_FALLBACKS=rookboss:am_michael,magsrust:af_sarah,kernelkline:am_eric,sudsmcgee:am_adam,dooby:am_echo,spaulding:am_onyx,string:am_fenrir,karen:af_nicole,nico:am_liam
ExecStart=/opt/bullshit-factory/.venv/bin/python3 /opt/bullshit-factory/server/bullshit-factory-tts.py
Restart=on-failure
RestartSec=8
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bullshit-factory /var/lib/bullshit-factory
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
