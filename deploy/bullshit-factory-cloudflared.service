[Unit]
Description=Bullshit Factory guarded Cloudflare Tunnel connector
After=network-online.target bullshit-factory.service
Wants=network-online.target

[Service]
Type=simple
User=bullshit-factory
Group=bullshit-factory
EnvironmentFile=-/etc/bullshit-factory/tunnel.env
Environment=HOME=/var/lib/bullshit-factory
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run
Restart=always
RestartSec=8
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/bullshit-factory

[Install]
WantedBy=multi-user.target
