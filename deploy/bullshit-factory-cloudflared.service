[Unit]
Description=Bullshit Factory guarded Cloudflare Tunnel connector
After=network-online.target bullshit-factory.service
Wants=network-online.target

[Service]
Type=simple
User=goblin
Group=goblin
EnvironmentFile=-/home/goblin/cave/bullshit-factory/tunnel.env
Environment=HOME=/home/goblin
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run
Restart=always
RestartSec=8
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/goblin/cave/bullshit-factory

[Install]
WantedBy=multi-user.target
