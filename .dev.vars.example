# Copy the settings you need into .dev.vars. Keep real credentials out of Git.
# This is a local/edge dashboard proxy reference; internal services should stay loopback-only.

BF_PRODUCTION_ENDPOINT=http://127.0.0.1:8793
BF_PRODUCTION_TOKEN=
BF_TTS_ENDPOINT=http://127.0.0.1:8798/tts
BF_TTS_TOKEN=
BF_TTS_CUSTOM_VOICES_PATH=./models/kokovoicelab/exported_voices/bullshit-factory-custom.bin
BF_TTS_VOICE_FALLBACKS=rookboss:am_michael,magsrust:af_sarah,kernelkline:am_eric,sudsmcgee:am_adam,dooby:am_echo,spaulding:am_onyx,string:am_fenrir,karen:af_nicole,nico:am_liam
BF_MUSIC_ADAPTER_ENDPOINT=http://127.0.0.1:8797
BF_MUSIC_ADAPTER_TOKEN=
BF_MUSIC_ENABLED=true
BF_MUSIC_PRIMARY=true
BF_MUSIC_GENERATION_SECONDS=30
BF_MUSIC_GENERATION_TIMEOUT_MS=600000
BF_GOBLIN_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
BF_GOBLIN_TOKEN=
BF_GOBLIN_MODEL=qwen3-8b-q4km
BF_GOBLIN_ENABLED=true

GROQ_API_KEY=
BF_GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
BF_GROQ_FREE_ONLY=true
BF_GROQ_MODEL=qwen/qwen3.8-27b
BF_GROQ_FALLBACK_MODELS=
GEMINI_API_KEY=
BF_GEMINI_SCRIPT_MODEL=gemini-3.5-flash
BF_ANIMATION_DIRECTOR_PROVIDER=gemini
BF_ANIMATION_DIRECTOR_ENABLED=true
BF_ANIMATION_DIRECTOR_MODEL=gemini-3.5-flash-lite
BF_ANIMATION_DIRECTOR_FALLBACK_MODELS=
BF_ANIMATION_DIRECTOR_GENERATION_TIMEOUT_MS=90000

HUGGINGFACE_API_KEY=
BF_HUGGINGFACE_ENDPOINT=https://router.huggingface.co/v1/chat/completions
BF_HUGGINGFACE_FREE_ONLY=true
BF_SCRIPT_WRITER_PROVIDER=groq
BF_SCRIPT_WRITER_ENABLED=true
BF_SCRIPT_WRITER_MODEL=
BF_SCRIPT_WRITER_FALLBACK_MODELS=
BF_SCRIPT_WRITER_GENERATION_TIMEOUT_MS=120000
BF_SCRIPT_WRITER_MAX_OUTPUT_TOKENS=8192
PIXELLAB_API_KEY=
BF_ANIMATION_MODEL=local-authored-clips
BF_ANIMATION_MAX_CONCURRENT_JOBS=8
FAL_API_KEY=
BF_H3_RUNTIME_ENABLED=false
BF_H3_HARD_BUDGET_USD=30
BF_H3_INTERNAL_STOP_USD=29

BF_AUDIENCE_QUEUE_MAX=100
BF_AUDIENCE_INGEST_TOKEN=
BF_YOUTUBE_ENABLED=false
BF_YOUTUBE_LIVE_VIDEO_ID=
BF_YOUTUBE_LIVE_CHAT_ID=
BF_YOUTUBE_BRIDGE_ENABLED=false
BF_YOUTUBE_ACCESS_TOKEN=
BF_YOUTUBE_REFRESH_TOKEN=
BF_YOUTUBE_CLIENT_ID=
BF_YOUTUBE_CLIENT_SECRET=

BF_ADMIN_USERNAME=
BF_ADMIN_PASSWORD_HASH=
BF_ADMIN_SESSION_SECRET=
