{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullshit-factory",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
